# URL base del backend. En local apunta a Spring Boot; en AWS es la URL de CloudFront Backend.
VITE_API_URL=http://localhost:8080

# Public key de MercadoPago del vendedor de prueba (prefijo APP_USR-).
# Debe pertenecer a la misma cuenta que el access token del backend.
VITE_MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# URL base del CDN de imagenes. En local dejar vacio; en AWS es la URL de CloudFront Media.
VITE_MEDIA_BUCKET_URL=
